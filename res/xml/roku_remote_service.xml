<?xml version="1.0" encoding="utf-8"?>
<!-- Projector Home v0.3.0 -->
<!-- Lets the service see remote-control key presses so they can be forwarded to the Roku
     while the projector's HDMI player is on screen. Window events are used only to learn
     which app is in front (package and class name); no window content is read. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/remote_service_description"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0" />
